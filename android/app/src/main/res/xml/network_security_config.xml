<?xml version="1.0" encoding="utf-8"?>
<!--
    개발 서버가 아직 HTTPS가 아니라서(http://54.116.211.144:8080) Android
    9(API 28) 이상 기본 정책이 이 요청을 차단합니다. 이 서버 주소에만
    평문(HTTP) 통신을 허용하고, 나머지는 기존처럼 HTTPS만 허용합니다.
    서버가 HTTPS로 바뀌면 이 파일과 매니페스트의 참조를 제거하면 됩니다.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">54.116.211.144</domain>
    </domain-config>
</network-security-config>
